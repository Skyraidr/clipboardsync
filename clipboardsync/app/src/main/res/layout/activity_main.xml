<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clipboard Sync"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PC IP Address:"
        android:textSize="14sp"/>

    <EditText
        android:id="@+id/ipInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. 192.168.1.5"
        android:inputType="textUri"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/saveBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Save Configuration"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/settingsBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Enable Background Service"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You must enable the Accessibility Service in settings for the clipboard sync to work in the background."
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:alpha="0.7"/>

</LinearLayout>